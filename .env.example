# Copie para .env e preencha. Só precisa das redes que vai usar.

PORT=3000
# URL público da app (sem / no fim). Tem de ser HTTPS e acessível pela internet
# para o OAuth e para o Instagram/TikTok irem buscar as imagens. Em testes use ngrok.
PUBLIC_URL=http://localhost:3000
# Chave para cifrar os tokens guardados. Gere uma: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Palavra-passe para entrar na app (utilizador: qualquer). Recomendado quando estiver online.
APP_PASSWORD=

# --- Meta (Facebook Pages + Instagram profissional) ---  developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# --- LinkedIn ---  linkedin.com/developers
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202605

# --- X (Twitter) ---  developer.x.com  (OAuth 2.0, tipo "Web App")
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- TikTok ---  developers.tiktok.com  (Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# SELF_ONLY até a app ser auditada pelo TikTok; depois PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY

# Minutos entre atualizações automáticas das métricas
METRICS_INTERVAL_MIN=30
